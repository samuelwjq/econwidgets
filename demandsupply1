<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Demand and Supply Diagram</title>
  <style>
    :root {
      --axis: #111111;
      --demand: #2563eb;
      --supply: #dc2626;
      --muted: #9ca3af;
      --border: #d1d5db;
      --background: #ffffff;
      --panel: #f9fafb;
      --text: #111827;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--background);
      color: var(--text);
      font-family: Arial, Helvetica, sans-serif;
    }

    .app {
      width: min(1100px, 100%);
      margin: 0 auto;
      padding: 24px;
    }

    h1 {
      margin: 0 0 20px;
      font-size: 1.5rem;
      font-weight: 600;
    }

    .layout {
      display: grid;
      grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
      gap: 28px;
      align-items: start;
    }

    .controls {
      border: 1px solid var(--border);
      background: var(--panel);
      padding: 20px;
    }

    .control-group + .control-group {
      margin-top: 24px;
    }

    .control-group label {
      display: block;
      margin-bottom: 10px;
      font-weight: 600;
    }

    .direction-labels {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-top: 6px;
      font-size: 0.86rem;
      color: #4b5563;
    }

    input[type="range"] {
      width: 100%;
      accent-color: #111111;
      cursor: pointer;
    }

    button {
      width: 100%;
      margin-top: 28px;
      padding: 10px 14px;
      border: 1px solid #111111;
      background: #ffffff;
      color: #111111;
      font: inherit;
      cursor: pointer;
    }

    button:hover {
      background: #f3f4f6;
    }

    button:focus-visible,
    input:focus-visible {
      outline: 3px solid rgba(37, 99, 235, 0.25);
      outline-offset: 2px;
    }

    .diagram-wrap {
      min-width: 0;
    }

    svg {
      display: block;
      width: 100%;
      height: auto;
      background: #ffffff;
    }

    .axis {
      stroke: var(--axis);
      stroke-width: 2.2;
      vector-effect: non-scaling-stroke;
    }

    .axis-label {
      fill: var(--axis);
      font-size: 18px;
      font-weight: 600;
    }

    .curve {
      fill: none;
      stroke-width: 2.4;
      stroke-linecap: round;
      vector-effect: non-scaling-stroke;
    }

    .curve.initial {
      opacity: 0.24;
    }

    .demand {
      stroke: var(--demand);
    }

    .supply {
      stroke: var(--supply);
    }

    .curve-label {
      font-size: 20px;
      font-weight: 700;
    }

    .curve-label.initial {
      opacity: 0.35;
    }

    .demand-label {
      fill: var(--demand);
    }

    .supply-label {
      fill: var(--supply);
    }

    .equilibrium-guide {
      stroke: #111111;
      stroke-width: 1;
      stroke-dasharray: 6 6;
      vector-effect: non-scaling-stroke;
    }

    .initial-guide {
      opacity: 0.35;
    }

    .equilibrium-point {
      fill: #111111;
    }

    .initial-point {
      opacity: 0.45;
    }

    .equilibrium-label {
      fill: #111111;
      font-size: 15px;
      font-weight: 600;
      paint-order: stroke;
      stroke: #ffffff;
      stroke-width: 5px;
      stroke-linejoin: round;
    }

    .axis-value {
      fill: #111111;
      font-size: 16px;
      font-weight: 600;
    }

    .initial-equilibrium-label,
    .initial-axis-value {
      opacity: 0.45;
    }


    .equilibrium-summary {
      margin-top: 28px;
      border: 1px solid var(--border);
      background: #ffffff;
    }

    .equilibrium-summary h2 {
      margin: 0;
      padding: 14px 18px;
      border-bottom: 1px solid var(--border);
      font-size: 1.05rem;
      font-weight: 600;
    }

    .equilibrium-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    .equilibrium-table th,
    .equilibrium-table td {
      width: 50%;
      padding: 12px 18px;
      text-align: left;
      vertical-align: top;
    }

    .equilibrium-table th {
      background: var(--panel);
      border-bottom: 1px solid var(--border);
      font-size: 1rem;
    }

    .equilibrium-table th + th,
    .equilibrium-table td + td {
      border-left: 1px solid var(--border);
    }

    .equilibrium-detail {
      display: grid;
      grid-template-columns: 90px 1fr;
      gap: 8px;
      margin: 0;
    }

    .equilibrium-detail + .equilibrium-detail {
      margin-top: 10px;
    }

    .equilibrium-term {
      font-weight: 600;
    }

    .equilibrium-value {
      font-style: italic;
    }

    .hint {
      margin-top: 10px;
      font-size: 0.9rem;
      color: #4b5563;
    }

    @media (max-width: 760px) {
      .app {
        padding: 16px;
      }

      .layout {
        grid-template-columns: 1fr;
      }

      .controls {
        order: 2;
      }

      .diagram-wrap {
        order: 1;
      }

      .equilibrium-table,
      .equilibrium-table thead,
      .equilibrium-table tbody,
      .equilibrium-table tr,
      .equilibrium-table th,
      .equilibrium-table td {
        display: block;
        width: 100%;
      }

      .equilibrium-table th + th,
      .equilibrium-table td + td {
        border-left: 0;
      }

      .equilibrium-table th:nth-child(2) {
        border-top: 1px solid var(--border);
      }

      .equilibrium-table td:first-child {
        border-bottom: 1px solid var(--border);
      }
    }
  </style>
</head>
<body>
  <main class="app">
    <h1>Demand & Supply Diagram</h1>

    <div class="layout">
      <section class="controls" aria-label="Diagram controls">
        <div class="control-group">
          <label for="demandSlider">Demand</label>
          <input
            id="demandSlider"
            type="range"
            min="-90"
            max="90"
            value="0"
            step="15"
          />
          <div class="direction-labels" aria-hidden="true">
            <span>Decrease</span>
            <span>Increase</span>
          </div>
        </div>

        <div class="control-group">
          <label for="supplySlider">Supply</label>
          <input
            id="supplySlider"
            type="range"
            min="-90"
            max="90"
            value="0"
            step="15"
          />
          <div class="direction-labels" aria-hidden="true">
            <span>Decrease</span>
            <span>Increase</span>
          </div>
        </div>

        <button id="resetButton" type="button"><strong>Reset Diagram</strong></button>

       <p class="hint" style="width: 100%; text-align: center;">
  Move the sliders to adjust the demand and supply curves.
</p>
      </section>

      <section class="diagram-wrap" aria-label="Demand and supply graph">
        <svg
          id="diagram"
          viewBox="0 0 760 560"
          role="img"
          aria-labelledby="diagramTitle diagramDescription"
        >
          <title id="diagramTitle">Interactive demand and supply diagram</title>
          <desc id="diagramDescription">
            A downward-sloping blue demand curve and an upward-sloping red supply curve.
            Sliders shift each curve left or right.
          </desc>

          <!-- Axes -->
          <line class="axis" x1="90" y1="470" x2="690" y2="470" />
          <line class="axis" x1="90" y1="470" x2="90" y2="55" />

          <!-- Arrowheads -->
          <path d="M690 470 L676 463 L676 477 Z" fill="#111111" />
          <path d="M90 55 L83 69 L97 69 Z" fill="#111111" />

          <!-- Axis labels -->
          <text class="axis-label" x="615" y="500">Quantity</text>
          <text class="axis-label" x="33" y="70">Price</text>

          <!-- Initial curves -->
          <g id="initialCurves">
            <line
              id="demandInitial"
              class="curve demand initial"
              x1="180"
              y1="115"
              x2="610"
              y2="420"
            />
            <line
              id="supplyInitial"
              class="curve supply initial"
              x1="180"
              y1="420"
              x2="610"
              y2="115"
            />

            <text
              id="demandInitialLabel"
              class="curve-label demand-label initial"
              x="615"
              y="430"
            >
              D₀
            </text>
            <text
              id="supplyInitialLabel"
              class="curve-label supply-label initial"
              x="615"
              y="112"
            >
              S₀
            </text>
          </g>

          <!-- Initial equilibrium annotations -->
          <g id="initialEquilibrium">
            <line id="initialPriceGuide" class="equilibrium-guide initial-guide" />
            <line id="initialQuantityGuide" class="equilibrium-guide initial-guide" />
            <circle id="initialEquilibriumPoint" class="equilibrium-point initial-point" r="4" />
            <text id="initialEquilibriumLabel" class="equilibrium-label initial-equilibrium-label">E₀</text>
            <text id="initialPriceLabel" class="axis-value initial-axis-value">P₀</text>
            <text id="initialQuantityLabel" class="axis-value initial-axis-value">Q₀</text>
          </g>

          <!-- Current curves -->
          <g id="currentCurves">
            <line
              id="demandCurrent"
              class="curve demand"
              x1="180"
              y1="115"
              x2="610"
              y2="420"
            />
            <line
              id="supplyCurrent"
              class="curve supply"
              x1="180"
              y1="420"
              x2="610"
              y2="115"
            />

            <text
              id="demandCurrentLabel"
              class="curve-label demand-label"
              x="615"
              y="430"
            >
              D₀
            </text>
            <text
              id="supplyCurrentLabel"
              class="curve-label supply-label"
              x="615"
              y="112"
            >
              S₀
            </text>
          </g>

          <!-- Shifted equilibrium annotations -->
          <g id="shiftedEquilibrium">
            <line id="shiftedPriceGuide" class="equilibrium-guide" />
            <line id="shiftedQuantityGuide" class="equilibrium-guide" />
            <circle id="shiftedEquilibriumPoint" class="equilibrium-point" r="4" />
            <text id="shiftedEquilibriumLabel" class="equilibrium-label">E₁</text>
            <text id="shiftedPriceLabel" class="axis-value">P₁</text>
            <text id="shiftedQuantityLabel" class="axis-value">Q₁</text>
          </g>
        </svg>
      </section>
    </div>

    <section class="equilibrium-summary" aria-labelledby="equilibriumSummaryTitle">
      <h2 id="equilibriumSummaryTitle">Comparison of Market Equilibria</h2>

      <table class="equilibrium-table">
        <thead>
          <tr>
            <th scope="col">Initial Market Equilibrium</th>
            <th scope="col">New Equilibrium</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <p class="equilibrium-detail">
                <span class="equilibrium-term">Condition:</span>
                <span class="equilibrium-value">D₀ = S₀</span>
              </p>
              <p class="equilibrium-detail">
                <span class="equilibrium-term">Price:</span>
                <span class="equilibrium-value">P₀</span>
              </p>
              <p class="equilibrium-detail">
                <span class="equilibrium-term">Quantity:</span>
                <span class="equilibrium-value">Q₀</span>
              </p>
            </td>

            <td>
              <p class="equilibrium-detail">
                <span class="equilibrium-term">Condition:</span>
                <span id="newEquilibriumCondition" class="equilibrium-value">
                  D₀ = S₀
                </span>
              </p>
              <p class="equilibrium-detail">
                <span class="equilibrium-term">Price:</span>
                <span id="newEquilibriumPrice" class="equilibrium-value">P₀</span>
              </p>
              <p class="equilibrium-detail">
                <span class="equilibrium-term">Quantity:</span>
                <span id="newEquilibriumQuantity" class="equilibrium-value">Q₀</span>
              </p>
            </td>
          </tr>
        </tbody>
      </table>
    </section>
  </main>

  <script>
    const demandSlider = document.getElementById("demandSlider");
    const supplySlider = document.getElementById("supplySlider");
    const resetButton = document.getElementById("resetButton");

    const newEquilibriumCondition = document.getElementById(
      "newEquilibriumCondition"
    );
    const newEquilibriumPrice = document.getElementById(
      "newEquilibriumPrice"
    );
    const newEquilibriumQuantity = document.getElementById(
      "newEquilibriumQuantity"
    );

    const demandCurrent = document.getElementById("demandCurrent");
    const supplyCurrent = document.getElementById("supplyCurrent");
    const demandCurrentLabel = document.getElementById("demandCurrentLabel");
    const supplyCurrentLabel = document.getElementById("supplyCurrentLabel");

    const initialPriceGuide = document.getElementById("initialPriceGuide");
    const initialQuantityGuide = document.getElementById("initialQuantityGuide");
    const initialEquilibriumPoint = document.getElementById("initialEquilibriumPoint");
    const initialEquilibriumLabel = document.getElementById("initialEquilibriumLabel");
    const initialPriceLabel = document.getElementById("initialPriceLabel");
    const initialQuantityLabel = document.getElementById("initialQuantityLabel");

    const shiftedEquilibriumGroup = document.getElementById("shiftedEquilibrium");
    const shiftedPriceGuide = document.getElementById("shiftedPriceGuide");
    const shiftedQuantityGuide = document.getElementById("shiftedQuantityGuide");
    const shiftedEquilibriumPoint = document.getElementById("shiftedEquilibriumPoint");
    const shiftedEquilibriumLabel = document.getElementById("shiftedEquilibriumLabel");
    const shiftedPriceLabel = document.getElementById("shiftedPriceLabel");
    const shiftedQuantityLabel = document.getElementById("shiftedQuantityLabel");

    const axisOrigin = { x: 90, y: 470 };

    const initialDemand = {
      x1: 180,
      y1: 115,
      x2: 610,
      y2: 420,
      labelX: 615,
      labelY: 430
    };

    const initialSupply = {
      x1: 180,
      y1: 420,
      x2: 610,
      y2: 115,
      labelX: 615,
      labelY: 112
    };

    function shiftedLine(base, shift) {
      return {
        x1: base.x1 + shift,
        y1: base.y1,
        x2: base.x2 + shift,
        y2: base.y2
      };
    }

    function updateLine(line, label, base, shift, baseLabel) {
      line.setAttribute("x1", base.x1 + shift);
      line.setAttribute("x2", base.x2 + shift);
      label.setAttribute("x", base.labelX + shift);
      label.textContent = shift !== 0 ? `${baseLabel}₁` : `${baseLabel}₀`;
    }

    function lineIntersection(a, b) {
      const denominator =
        (a.x1 - a.x2) * (b.y1 - b.y2) -
        (a.y1 - a.y2) * (b.x1 - b.x2);

      if (denominator === 0) return null;

      const determinantA = a.x1 * a.y2 - a.y1 * a.x2;
      const determinantB = b.x1 * b.y2 - b.y1 * b.x2;

      return {
        x:
          (determinantA * (b.x1 - b.x2) -
            (a.x1 - a.x2) * determinantB) /
          denominator,
        y:
          (determinantA * (b.y1 - b.y2) -
            (a.y1 - a.y2) * determinantB) /
          denominator
      };
    }

    function positionEquilibrium(elements, point) {
      elements.priceGuide.setAttribute("x1", axisOrigin.x);
      elements.priceGuide.setAttribute("y1", point.y);
      elements.priceGuide.setAttribute("x2", point.x);
      elements.priceGuide.setAttribute("y2", point.y);

      elements.quantityGuide.setAttribute("x1", point.x);
      elements.quantityGuide.setAttribute("y1", point.y);
      elements.quantityGuide.setAttribute("x2", point.x);
      elements.quantityGuide.setAttribute("y2", axisOrigin.y);

      elements.point.setAttribute("cx", point.x);
      elements.point.setAttribute("cy", point.y);

      elements.eLabel.setAttribute("x", point.x);
      elements.eLabel.setAttribute("y", point.y - 18);
      elements.eLabel.setAttribute("text-anchor", "middle");

      elements.pLabel.setAttribute("x", axisOrigin.x - 18);
      elements.pLabel.setAttribute("y", point.y + 6);
      elements.pLabel.setAttribute("text-anchor", "end");

      elements.qLabel.setAttribute("x", point.x);
      elements.qLabel.setAttribute("y", axisOrigin.y + 30);
      elements.qLabel.setAttribute("text-anchor", "middle");
    }

    const initialIntersection = lineIntersection(initialDemand, initialSupply);

    positionEquilibrium(
      {
        priceGuide: initialPriceGuide,
        quantityGuide: initialQuantityGuide,
        point: initialEquilibriumPoint,
        eLabel: initialEquilibriumLabel,
        pLabel: initialPriceLabel,
        qLabel: initialQuantityLabel
      },
      initialIntersection
    );


    function updateEquilibriumSummary(demandShift, supplyShift) {
      const demandIndex = demandShift === 0 ? "₀" : "₁";
      const supplyIndex = supplyShift === 0 ? "₀" : "₁";
      const hasShifted = demandShift !== 0 || supplyShift !== 0;

      newEquilibriumCondition.textContent =
        `D${demandIndex} = S${supplyIndex}`;
      newEquilibriumPrice.textContent = hasShifted ? "P₁" : "P₀";
      newEquilibriumQuantity.textContent = hasShifted ? "Q₁" : "Q₀";
    }

    function updateDiagram() {
      const demandShift = Number(demandSlider.value);
      const supplyShift = Number(supplySlider.value);

      updateLine(
        demandCurrent,
        demandCurrentLabel,
        initialDemand,
        demandShift,
        "D"
      );

      updateLine(
        supplyCurrent,
        supplyCurrentLabel,
        initialSupply,
        supplyShift,
        "S"
      );

      const currentDemand = shiftedLine(initialDemand, demandShift);
      const currentSupply = shiftedLine(initialSupply, supplyShift);
      const currentIntersection = lineIntersection(currentDemand, currentSupply);
      const hasShifted = demandShift !== 0 || supplyShift !== 0;

      shiftedEquilibriumGroup.style.display = hasShifted ? "block" : "none";

      updateEquilibriumSummary(demandShift, supplyShift);

      if (hasShifted && currentIntersection) {
        positionEquilibrium(
          {
            priceGuide: shiftedPriceGuide,
            quantityGuide: shiftedQuantityGuide,
            point: shiftedEquilibriumPoint,
            eLabel: shiftedEquilibriumLabel,
            pLabel: shiftedPriceLabel,
            qLabel: shiftedQuantityLabel
          },
          currentIntersection
        );
      }
    }

    function resetDiagram() {
      demandSlider.value = 0;
      supplySlider.value = 0;
      updateDiagram();
    }

    demandSlider.addEventListener("input", updateDiagram);
    supplySlider.addEventListener("input", updateDiagram);
    resetButton.addEventListener("click", resetDiagram);

    updateDiagram();
  </script>
</body>
</html>
